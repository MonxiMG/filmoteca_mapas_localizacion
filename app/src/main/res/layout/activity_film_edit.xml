<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FilmEditActivity">

    <!-- AppBar con Toolbar. La flecha se activa desde FilmEditActivity. -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:popupTheme="@style/ThemeOverlay.Material3.Light"
            app:title="Editar película" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido desplazable de la pantalla de edición. -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fila superior: cartel de la película y botones de imagen. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivPosterEdit"
                    android:layout_width="96dp"
                    android:layout_height="140dp"
                    android:src="@drawable/pelicula_a"
                    android:contentDescription="@string/cd_poster_edit"
                    android:scaleType="centerCrop"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Botón para abrir la cámara. -->
                    <Button
                        android:id="@+id/btnTakePhoto"
                        style="@style/BlackButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_take_photo"
                        android:layout_marginBottom="8dp"
                        app:backgroundTint="@color/buttonBlack"
                        android:textColor="@color/textYellow" />

                    <!-- Botón para seleccionar una imagen del dispositivo. -->
                    <Button
                        android:id="@+id/btnPickImage"
                        style="@style/BlackButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/action_pick_image"
                        app:backgroundTint="@color/buttonBlack"
                        android:textColor="@color/textYellow" />
                </LinearLayout>
            </LinearLayout>

            <!-- Título de la película. -->
            <EditText
                android:id="@+id/etTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_title"
                android:inputType="textCapWords"
                android:layout_marginBottom="12dp" />

            <!-- Director de la película. -->
            <EditText
                android:id="@+id/etDirector"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_director"
                android:inputType="textCapWords"
                android:layout_marginBottom="12dp" />

            <!-- Año de estreno. -->
            <EditText
                android:id="@+id/etYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_year"
                android:inputType="number"
                android:maxLength="4"
                android:layout_marginBottom="12dp" />

            <!-- Género de la película. -->
            <Spinner
                android:id="@+id/spGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/genres"
                android:prompt="@string/prompt_genre"
                android:layout_marginBottom="12dp" />

            <!-- Formato de la película. -->
            <Spinner
                android:id="@+id/spFormat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:entries="@array/formats"
                android:prompt="@string/prompt_format"
                android:layout_marginBottom="12dp" />

            <!-- Enlace a IMDb. -->
            <EditText
                android:id="@+id/etImdb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_imdb"
                android:inputType="textUri"
                android:layout_marginBottom="12dp" />

            <!-- Notas de la película. -->
            <EditText
                android:id="@+id/etNotes"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="@string/hint_notes"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:overScrollMode="always"
                android:layout_marginBottom="16dp" />

            <!-- Sección de geocercado.
                 La práctica pide permitir añadir y eliminar geocercado desde la pantalla de edición. -->
            <TextView
                android:id="@+id/tvGeofenceTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Geocercado de la película"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />

            <!-- Botones Añadir geocercado / Eliminar geocercado. -->
            <LinearLayout
                android:id="@+id/layoutGeofenceButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <!-- Botón para añadir una geocerca de 500 metros a la película. -->
                <Button
                    android:id="@+id/btnAddGeofence"
                    style="@style/BlackButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Añadir geocercado"
                    android:layout_marginEnd="8dp"
                    app:backgroundTint="@color/buttonBlack"
                    android:textColor="@color/textYellow" />

                <!-- Botón para eliminar la geocerca de la película. -->
                <Button
                    android:id="@+id/btnRemoveGeofence"
                    style="@style/BlackButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Eliminar geocercado"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="@color/buttonBlack"
                    android:textColor="@color/textYellow" />
            </LinearLayout>

            <!-- Botones Guardar / Cancelar. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <!-- Botón para guardar los datos de la película. -->
                <Button
                    android:id="@+id/btnSave"
                    style="@style/BlackButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_save"
                    android:layout_marginEnd="8dp"
                    app:backgroundTint="@color/buttonBlack"
                    android:textColor="@color/textYellow" />

                <!-- Botón para cancelar la edición. -->
                <Button
                    android:id="@+id/btnCancel"
                    style="@style/BlackButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_cancel"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="@color/buttonBlack"
                    android:textColor="@color/textYellow" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>